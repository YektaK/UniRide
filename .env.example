# ═══════════════════════════════════════════════════════════════
# UniRide Environment Variables
# Copy to .env.local (Next.js) and optimizer_api/.env (FastAPI)
# ═══════════════════════════════════════════════════════════════

# ─── FastAPI Optimizer Service ───────────────────────────────
# Required: shared secret between Next.js and FastAPI
INTERNAL_API_KEY=dev-secret-change-me

# Optional: set to 1 for local dev without auth
# FORBIDDEN when APP_ENV=production (will cause SystemExit)
# UNIRIDE_DISABLE_AUTH=1

# Optional: "production" enforces auth + blocks disable-auth
# APP_ENV=development

# Optional: bind address (default: 127.0.0.1 loopback only)
# OPTIMIZER_HOST=127.0.0.1

# Optional: bind port (default: 8000)
# OPTIMIZER_PORT=8000

# Optional: required for non-loopback OPTIMIZER_HOST
# ALLOW_PUBLIC_BIND=1

# Optional: comma-separated CORS allowlist
# ALLOWED_ORIGINS=http://localhost:9002,http://127.0.0.1:9002,http://localhost:3000,http://127.0.0.1:3000

# ─── Compute Policy (lowering-only overrides) ───────────────
# These can ONLY lower the hard ceilings, never raise them.
# UNIRIDE_COMPUTE_MAX_STUDENTS=250
# UNIRIDE_COMPUTE_MAX_VEHICLES=50
# UNIRIDE_COMPUTE_MAX_ALGORITHMS=6
# UNIRIDE_COMPUTE_MAX_WORKERS=2
# UNIRIDE_COMPUTE_DEADLINE_SECONDS=120
# UNIRIDE_COMPUTE_SOLVER_SECONDS=60
# UNIRIDE_COMPUTE_MAX_ITERATIONS=2000
# UNIRIDE_COMPUTE_MAX_POPULATION=250
# UNIRIDE_COMPUTE_LOCAL_SEARCH_SECONDS=2

# ─── Matrix Provider ────────────────────────────────────────
# TIME_MATRIX_CACHE_TTL_SECONDS=600
# TIME_MATRIX_PROVIDER_TIMEOUT_SECONDS=10.0

# ─── Next.js Server-Side (copy to .env.local) ──────────────
# Required: must match INTERNAL_API_KEY above
OPTIMIZER_INTERNAL_API_KEY=dev-secret-change-me

# Optional: FastAPI optimizer URL (default: http://127.0.0.1:8000)
# OPTIMIZER_API_URL=http://127.0.0.1:8000

# ─── Supabase (required for runtime, NOT for build) ────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: server-side Supabase URL (Python/data_loader)
# SUPABASE_URL=https://your-project.supabase.co

# ─── Dev Reset (Next.js server, local/test only) ──────────
# ENABLE_DEV_RESET=true
# DEV_RESET_SECRET=change-me

# ─── Azure AI (optional utility, Python) ──────────────────
# AZURE_AI_ENDPOINT=https://uniride-resource.services.ai.azure.com/models
# AZURE_AI_API_KEY=your-key
# AZURE_AI_API_VERSION=2025-01-01-preview