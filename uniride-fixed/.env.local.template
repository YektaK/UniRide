# =============================================================================
# UniRide Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# =============================================================================

# ====================
# Supabase Configuration (Required)
# ====================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================
# Optimizer API Configuration
# ====================
# Python VRP optimizer API URL (for route optimization)
# Default: http://127.0.0.1:8000 (local development)
OPTIMIZER_API_URL=http://127.0.0.1:8000

# Alternative: Use this if you want to set it as public (exposed to client)
# NEXT_PUBLIC_OPTIMIZER_API_URL=http://127.0.0.1:8000

# ====================
# Application Settings (Optional)
# ====================
# Environment: development, production, test
NODE_ENV=development

# Application URL (for email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:9002

# ====================
# Logging (Optional)
# ====================
# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ====================
# Rate Limiting (Optional)
# ====================
# Requests per minute for API endpoints
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# HOW TO GET SUPABASE CREDENTIALS:
# =============================================================================
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy:
#    - URL → NEXT_PUBLIC_SUPABASE_URL
#    - anon/public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key → SUPABASE_SERVICE_ROLE_KEY (KEEP SECRET!)
#
# IMPORTANT: Never commit .env.local to version control!
# =============================================================================
